# Copy to .env and fill in. Without any provider key the API still runs,
# but fraud scoring falls back to deterministic rules.

# Which provider scores fraud risk: deepseek | claude
# Defaults to deepseek. If the chosen provider has no key, any other
# configured provider is used instead.
SCORING_PROVIDER=deepseek

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic — optional, for comparing the two
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Server
PORT=8000
LOG_LEVEL=info

# Fish Audio — voice for claimant intake. Without it, intake stays
# text-only and the mic button is hidden.
FISH_AUDIO_API_KEY=
# FISH_TTS_MODEL=s2.1-pro
# FISH_VOICE_ID=            # a reference_id from fish.audio, optional

# Deepgram Voice Agent — real-time voice intake. Takes precedence over
# Fish Audio when set. Without either, intake falls back to browser
# speech (Chrome/Edge only).
DEEPGRAM_API_KEY=
# DEEPGRAM_LISTEN_MODEL=flux-general-en
# DEEPGRAM_SPEAK_MODEL=flux-kit-en
